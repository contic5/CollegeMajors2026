@page
@model CollegeMajors2026.Pages.CollegeMajors.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<form>
    <p>
        <select asp-for="CredentialName" asp-items="Model.CredentialName">
            <option value="">All</option>
        </select>
        <label>Instituion Name: <input type="text" asp-for="InstituionName" /></label>
        <input type="submit" value="Filter" />
    </p>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CollegeMajor[0].Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CollegeMajor[0].InstituionName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CollegeMajor[0].InstitutionState)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CollegeMajor[0].CipTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CollegeMajor[0].CredentialLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CollegeMajor[0].CredentialName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CollegeMajor[0].MedianEarnings4yrUSD)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CollegeMajor[0].EarningsVsNationalPct)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CollegeMajor[0].EarningsGrowthPct1YrTo5Yr)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.CollegeMajor) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InstituionName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InstitutionState)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CipTitle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CredentialLevel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CredentialName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MedianEarnings4yrUSD)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EarningsVsNationalPct)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EarningsGrowthPct1YrTo5Yr)
            </td>
            <td>
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
            </td>
        </tr>
}
    </tbody>
</table>
